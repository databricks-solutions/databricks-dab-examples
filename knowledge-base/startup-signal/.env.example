DATABRICKS_HOST=https://...
DATABRICKS_APP_PORT=8000
DATABRICKS_APP_NAME=startup-signal

# For local dev: set these to your Lakebase endpoint path and host.
# In production these are injected by the platform.
LAKEBASE_ENDPOINT=projects/starter/branches/production/endpoints/primary
PGHOST=ep-xxxx.database.us-east-2.cloud.databricks.com
PGDATABASE=databricks_postgres
PGPORT=5432
PGSSLMODE=require
